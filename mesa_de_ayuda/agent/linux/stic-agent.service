[Unit]
Description=STIC Agent - Mesa de Ayuda Asset Inventory Service
Documentation=https://soporte.yopal.gov.co
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/stic-agent
ExecStart=/usr/bin/python3 /opt/stic-agent/agent_linux.py daemon
Restart=always
RestartSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
